{
    "name": "pieceofcake2/xform",
    "description": "Xform (Plugin) extends cakephp Form helper.",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "form"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "pieceofcake2/cakephp": "^2.10"
    },
    "replace": {
        "ichikaway/xform": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "installer-name": "Xform"
    },
    "require-dev": {
        "pieceofcake2/app": "^2.1"
    }
}
